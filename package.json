    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@angular/service-worker": "^22.1.2",
    "@mlc-ai/web-llm": "^0.2.84",
    "@popperjs/core": "^2.11.8",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "crypto-js": "^4.2.0",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "marked": "^18.0.10",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
