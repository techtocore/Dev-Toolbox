    "@eslint/js": "^10.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.2.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.6",
    "angular-eslint": "^22.1.0",
    "eslint": "^10.8.1",
    "jasmine-core": "^6.3.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
